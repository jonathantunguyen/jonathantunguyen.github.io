# Copy to .env.local and fill in.

# ---------------------------------------------------------------------------
# The AI assistant
# ---------------------------------------------------------------------------
# Which model answers: "gemini" (default) or "anthropic". Whichever you pick, a
# missing key silently falls back to the other provider, and with neither key
# the route still answers — from the keyword index in lib/chat-fallback.ts.
CHAT_PROVIDER=gemini

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional model overrides. Defaults: gemini-3.7-flash and claude-opus-5.
GEMINI_MODEL=
ANTHROPIC_MODEL=

# ---------------------------------------------------------------------------
# Assistant guardrails (all optional — the defaults are sane)
# ---------------------------------------------------------------------------
# Site-wide question ceiling per UTC day. The backstop for the per-IP limit,
# which anyone with a pool of addresses can walk around. Default 400.
CHAT_DAILY_LIMIT=

# How many proxies sit in front of this app. 1 covers Railway or Vercel alone;
# raise it if you add another layer (e.g. Cloudflare in front), or the rate
# limiter can end up bucketing every visitor under the nearest proxy address.
CHAT_TRUSTED_PROXIES=

# Extra origins allowed to POST to /api/chat, comma-separated. Same-origin is
# always allowed; set this when the static `pages` build calls this endpoint
# cross-origin (e.g. jonathantunguyen.github.io).
CHAT_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Absolute site URL, used by canonical tags, hreflang alternates, sitemap.xml
# and robots.txt. On Railway and Vercel this falls back to the deployment's own
# domain, so it's only needed for a custom domain.
NEXT_PUBLIC_SITE_URL=

# Optional. Overrides where the assistant sends questions; defaults to this
# app's own /api/chat. Set it to an absolute URL to call a chat API hosted
# elsewhere (keep the trailing slash), or to an empty string to force offline
# keyword answers.
NEXT_PUBLIC_CHAT_ENDPOINT=
