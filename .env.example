# Copy to .env.local and fill in.

# Powers the AI assistant. Without it the route still answers, but from the
# keyword index in lib/chat-fallback.ts rather than a model.
ANTHROPIC_API_KEY=

# Absolute site URL, used by canonical tags, hreflang alternates, sitemap.xml
# and robots.txt. On Vercel this falls back to the deployment's production
# domain, so it's only needed for a custom domain.
NEXT_PUBLIC_SITE_URL=

# Optional. Overrides where the assistant sends questions; defaults to this
# app's own /api/chat. Set it to an absolute URL to call a chat API hosted
# elsewhere, or to an empty string to force offline keyword answers.
NEXT_PUBLIC_CHAT_ENDPOINT=
