# Copy to .env.local and fill in.

# ---------------------------------------------------------------------------
# The AI assistant
# ---------------------------------------------------------------------------
# Which model answers: "gemini" (default) or "anthropic". Whichever you pick, a
# missing key silently falls back to the other provider, and with neither key
# the route still answers — from the keyword index in lib/chat-fallback.ts.
CHAT_PROVIDER=gemini

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional model overrides. Defaults: gemini-3.7-flash and claude-opus-5.
GEMINI_MODEL=
ANTHROPIC_MODEL=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Absolute site URL, used by canonical tags, hreflang alternates, sitemap.xml
# and robots.txt. On Railway and Vercel this falls back to the deployment's own
# domain, so it's only needed for a custom domain.
NEXT_PUBLIC_SITE_URL=

# Optional. Overrides where the assistant sends questions; defaults to this
# app's own /api/chat. Set it to an absolute URL to call a chat API hosted
# elsewhere (keep the trailing slash), or to an empty string to force offline
# keyword answers.
NEXT_PUBLIC_CHAT_ENDPOINT=
